---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

import lawnImg from '../assets/photos/events_the_overlook_ceremony_lawn.jpg';
import dinnerImg from '../assets/photos/events_clubhouse_dinner_reception.jpg';
import walkImg from '../assets/photos/gallery_02_foursome_walking_long_shadows.jpg';

const spaces = [
  { n: 'The Overlook', img: lawnImg,
    alt: 'An outdoor ceremony on a lawn above the valley, guests seated as the sun sets behind the ridges',
    b: 'Outdoor ceremonies and cocktail hours with the ridge standing behind you and the valley dropping away below.',
    note: 'Capacity TBD. The exact lawn to be confirmed with ownership.' },
  { n: 'The Clubhouse', img: dinnerImg,
    alt: 'A long candlelit table set for a reception under timber beams, mountains through the windows',
    b: 'Receptions and dinners, with the bar included by definition rather than as a line item.',
    note: 'Seated and standing capacities TBD.' },
  { n: 'Golf, obviously', img: walkImg,
    alt: 'Four players walking the fairway together in fall light',
    b: 'Add nine or eighteen for the wedding party, the groomsmen, or the whole guest list the morning after.',
    note: '' },
];
---

<BaseLayout
  title="Events & Weddings | Whiskey Ridge Golf Resort"
  description="Weddings, rehearsal dinners and corporate events above Cedar Creek in Bristol, Tennessee. Ridge views, a clubhouse, and a bar ten steps away."
>
  <PageHero
    eyebrow="Events & weddings"
    title="A ridge at sunset is"
    em="hard to argue with."
    lead="Weddings, rehearsal dinners, retirement parties and the company holiday thing people actually show up to, with the valley below and the bar ten steps away."
    image={lawnImg}
    alt="An outdoor ceremony on a lawn above the valley as the sun sets behind the ridges"
  />

  <!-- spaces -->
  <section class="section band" aria-labelledby="spaces-h">
    <div class="shell">
      <p class="eyebrow">The spaces</p>
      <h2 id="spaces-h" class="heading">Three rooms, one of them outdoors.</h2>
      <ul class="grid grid--3 spaces">
        {spaces.map((s) => (
          <li class="card">
            <Image class="card__img" src={s.img} alt={s.alt}
                   widths={[320, 480, 640]} sizes="(max-width: 1000px) 100vw, 33vw" quality={70} />
            <div class="card__body">
              <h3 class="subhead">{s.n}</h3>
              <p class="prose card__copy">{s.b}</p>
              {s.note && <p class="meta tbd-note">{s.note}</p>}
            </div>
          </li>
        ))}
      </ul>
      <p class="meta split__fine">
        Venue capacities, catering options and rental pricing are open inputs. The layouts above
        are built to take them without redesign.
      </p>
    </div>
  </section>

  <!-- inquiry -->
  <section id="inquiry" class="section band band--soft" aria-labelledby="inq-h">
    <div class="shell split split--narrow">
      <div>
        <p class="eyebrow">Check a date</p>
        <h2 id="inq-h" class="heading">Tell us the day. We'll tell you the truth.</h2>
        <p class="prose split__p">
          If a Speedway weekend or an outing already owns your date you will hear it in the first
          reply, along with the nearest date that works. We would rather lose the booking than
          waste your planning.
        </p>
        <p class="prose split__p">Replies within one business day.</p>
      </div>

      <form class="form" aria-labelledby="inq-h" data-demo-form data-done-body="You will hear back within one business day. If a Speedway weekend or an outing already owns your date, that reply says so, along with the nearest date that works.">
        <div class="form__row form__row--2">
          <div class="field">
            <label for="e-type">Event type</label>
            <select class="input" id="e-type" name="type">
              <option>Wedding</option><option>Rehearsal dinner</option>
              <option>Corporate event</option><option>Private party</option>
              <option>Celebration of life</option>
            </select>
          </div>
          <div class="field">
            <label for="e-guests">Guests</label>
            <select class="input" id="e-guests" name="guests">
              <option>50–100</option><option>Under 50</option>
              <option>100–150</option><option>150+</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="e-date">Date or season</label>
          <input class="input" id="e-date" name="date" type="text" placeholder="October 2027, flexible" autocomplete="off" />
        </div>
        <div class="form__row form__row--2">
          <div class="field">
            <label for="e-name">Your name</label>
            <input class="input" id="e-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="e-email">Email</label>
            <input class="input" id="e-email" name="email" type="email" inputmode="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="e-note">Anything we should know? (optional)</label>
          <textarea class="input" id="e-note" name="note" rows="3"></textarea>
        </div>
        <button class="btn btn--primary" type="submit">Check my date</button>
      </form>
    </div>
  </section>

  <!-- close -->
  <section class="section band band--char" aria-labelledby="ev-close">
    <div class="shell cta-row">
      <div>
        <h2 id="ev-close" class="heading">Come and walk it first.</h2>
        <p class="prose cta-row__p">
          Photographs flatten a ridge. If the date matters, come and stand on the lawn at the
          hour you are thinking of, and we will open the bar.
        </p>
      </div>
      <a class="btn btn--primary" href="#inquiry">Ask about a date</a>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/demo-form';
</script>

<style>
  .spaces { margin-top: var(--space-6); }
  textarea.input { min-height: 96px; resize: vertical; }
</style>
