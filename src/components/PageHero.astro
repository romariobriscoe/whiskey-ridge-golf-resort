---
import { Image } from 'astro:assets';

interface Props {
  eyebrow: string;
  title: string;
  /** Italic, accent-colored tail of the headline. */
  em?: string;
  lead?: string;
  image?: ImageMetadata;
  alt?: string;
}
const { eyebrow, title, em, lead, image, alt = '' } = Astro.props;
---
<section class:list={['phero', 'band', 'band--char', image && 'phero--img']} aria-labelledby="page-h">
  {image && (
    <>
      <Image
        class="phero__img"
        src={image}
        alt={alt}
        widths={[900, 1280, 1600]}
        sizes="(max-width: 700px) 1280px, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={72}
      />
      <div class="phero__scrim" aria-hidden="true"></div>
    </>
  )}
  <div class="shell phero__inner intro">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-h" class="display phero__h">{title}{em && <> <em>{em}</em></>}</h1>
    {lead && <p class="lead phero__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; isolation: isolate; overflow: hidden; }
  .phero__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 42%; z-index: -2;
  }
  .phero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(
        to right,
        rgba(20, 17, 15, 0.88) 0%,
        rgba(20, 17, 15, 0.74) 42%,
        rgba(20, 17, 15, 0.40) 74%,
        rgba(20, 17, 15, 0.30) 100%
      ),
      linear-gradient(to bottom, rgba(20, 17, 15, 0.32) 0%, rgba(20, 17, 15, 0) 30%);
  }
  .phero__inner { padding-block: clamp(3rem, 1.75rem + 5vw, 5.5rem); }
  .phero--img .phero__inner { padding-block: clamp(3.5rem, 2rem + 6vw, 6.5rem); }
  .phero__h { margin-top: var(--space-2); max-width: 19ch; }
  .phero__lead { margin-top: var(--space-3); color: var(--wr-line); max-width: 46ch; }

  @media (max-width: 640px) {
    .phero__scrim {
      background: linear-gradient(
        to bottom,
        rgba(20, 17, 15, 0.76) 0%,
        rgba(20, 17, 15, 0.58) 55%,
        rgba(20, 17, 15, 0.72) 100%
      );
    }
  }
</style>
