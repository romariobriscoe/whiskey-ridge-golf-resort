---
/* ------------------------------------------------------------------
   SIGNATURE ELEMENT — The Tee Sheet Ticker.

   Whiskey Ridge opens with one lifetime review against competitors
   carrying 250. Reviews can't be manufactured; a filling tee sheet can
   be shown. The ticker is the booking affordance and the social proof
   in one object: it cycles the next open times and turns gold when a
   time drops to two spots.

   It rises from the bottom edge only when nothing needs that corner: it
   stays tucked while the hero's own booking buttons or the footer are on
   screen, and steps aside for any link, button or field that scrolls under
   it. On phones it is a docked bar with its own strip, so only the footer
   tucks it.

   In production the entries come from the booking provider's live
   sheet (TBD). Here they come from src/data/site.ts.
   ------------------------------------------------------------------ */
import { teeSheet, booking, url } from '../data/site';
---
<aside class="ticker" data-ticker data-entries={JSON.stringify(teeSheet)} aria-label="Live tee sheet">
  <div class="ticker__body">
    <p class="ticker__head">
      <span class="ticker__dot" aria-hidden="true"></span>On the sheet now
    </p>
    <!-- The rotating pair is visual only. Announcing it would interrupt a screen
         reader every few seconds for the whole visit, so the list below carries
         the same times once. -->
    <p class="ticker__when" data-ticker-when aria-hidden="true">{teeSheet[0].when}</p>
    <p class="ticker__note" data-ticker-note aria-hidden="true" data-low={teeSheet[0].low ? 'true' : 'false'}>
      {teeSheet[0].note}
    </p>
    <ul class="visually-hidden">
      {teeSheet.map((e) => <li>{e.when}: {e.note}</li>)}
    </ul>
  </div>
  <a class="ticker__cta" href={url(booking.href)}>Book</a>
  <button class="ticker__x" type="button" data-ticker-dismiss aria-label="Hide the tee sheet">
    <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
      <path d="M1 1 11 11 M11 1 1 11" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
    </svg>
  </button>
</aside>
<p class="visually-hidden" role="status" data-ticker-status></p>

<!-- Tucks before first paint, so it rises into place instead of flashing in and
     sliding away. Without JS this never runs and the ticker simply stays put. -->
<script is:inline>document.querySelector('[data-ticker]').classList.add('is-tucked');</script>

<script>
  interface Entry { when: string; note: string; low: boolean }

  const root = document.querySelector<HTMLElement>('[data-ticker]');
  const entries: Entry[] = JSON.parse(root?.dataset.entries ?? '[]');
  const when = root?.querySelector<HTMLElement>('[data-ticker-when]');
  const note = root?.querySelector<HTMLElement>('[data-ticker-note]');

  if (root && when && note && entries.length >= 2) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const swapping = [when, note];

    let n = 0;
    let held = false;
    let timer: number | undefined;

    // Old line fades out, then the new one rises. Alternating the class
    // restarts the rise on every change.
    const paint = () => {
      swapping.forEach((el) => el.classList.add('is-out'));
      window.setTimeout(() => {
        const e = entries[n % entries.length];
        when.textContent = e.when;
        note.textContent = e.note;
        note.dataset.low = String(e.low);
        const cls = n % 2 ? 'is-b' : 'is-a';
        swapping.forEach((el) => {
          el.classList.remove('is-a', 'is-b', 'is-out');
          el.classList.add(cls);
        });
      }, 120);
    };

    const start = () => {
      if (timer || reduce.matches || root.hidden) return;
      timer = window.setInterval(() => {
        if (!held && !document.hidden) { n += 1; paint(); }
      }, 4200);
    };
    const stop = () => { window.clearInterval(timer); timer = undefined; };

    // Never move while being read, by pointer or by keyboard.
    root.addEventListener('pointerenter', () => { held = true; });
    root.addEventListener('pointerleave', () => { held = false; });
    root.addEventListener('focusin', () => { held = true; });
    root.addEventListener('focusout', () => { held = false; });

    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()));
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // It follows without nagging: a floating pill has to be dismissible.
    // Remembered for the session only, so it returns on the next visit.
    const KEY = 'wr-ticker-hidden';
    const read = () => { try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; } };
    const write = () => { try { sessionStorage.setItem(KEY, '1'); } catch { /* private mode */ } };

    if (read()) {
      root.hidden = true;
    } else {
      /* ---- when to get out of the way ---- */
      const phone = window.matchMedia('(max-width: 640px)');
      const blockers = new Set<Element>();
      const sync = () => {
        // Never yank it away from someone who has focus inside it.
        if (blockers.size && root.contains(document.activeElement)) return;
        root.classList.toggle('is-tucked', blockers.size > 0);
      };
      const track: IntersectionObserverCallback = (changes) => {
        changes.forEach((c) => (c.isIntersecting ? blockers.add(c.target) : blockers.delete(c.target)));
        sync();
      };

      let observers: IntersectionObserver[] = [];
      const watch = () => {
        observers.forEach((o) => o.disconnect());
        blockers.clear();

        // Whole-viewport: the footer always, the hero's booking buttons on desktop.
        const page = new IntersectionObserver(track);
        document.querySelectorAll('footer').forEach((el) => page.observe(el));
        if (!phone.matches) {
          document.querySelectorAll('.hero__cta, .phero').forEach((el) => page.observe(el));
        }
        observers = [page];
        if (phone.matches) return;

        // The ticker's own resting rectangle: anything interactive passing through
        // it would be covered. The tucked transform comes off for the measurement.
        const was = root.classList.contains('is-tucked');
        root.style.transition = 'none';
        root.classList.remove('is-tucked');
        const r = root.getBoundingClientRect();
        root.classList.toggle('is-tucked', was);
        void root.offsetHeight; // commit the tucked state before transitions come back
        root.style.transition = '';
        // 8px of slack, so it clears out before anything actually touches it.
        const vw = document.documentElement.clientWidth;
        const vh = window.innerHeight;
        const gap = 8;
        const corner = new IntersectionObserver(track, {
          rootMargin: `${gap - Math.round(r.top)}px ${gap - Math.round(vw - r.right)}px ${gap - Math.round(vh - r.bottom)}px ${gap - Math.round(r.left)}px`,
        });
        // Gallery tiles are excepted: each is a huge target, and they fill the page.
        document.querySelectorAll('main a:not(.gal__link), main button, main input, main select, main textarea')
          .forEach((el) => corner.observe(el));
        observers.push(corner);
      };

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(watch, 150);
      });
      watch();

      root.querySelector('[data-ticker-dismiss]')?.addEventListener('click', () => {
        stop();
        observers.forEach((o) => o.disconnect());
        root.classList.add('is-tucked');
        write();
        const status = document.querySelector('[data-ticker-status]');
        if (status) status.textContent = 'Tee sheet hidden for this visit.';
        // Leave the same way it came in, then come out of the page entirely.
        window.setTimeout(() => { root.hidden = true; }, 220);
      });

      start();
    }
  }
</script>

<style>
  .ticker {
    position: fixed; z-index: 60;
    display: flex; align-items: stretch; overflow: hidden;
    background: var(--wr-char);
    border: 1px solid #3A352F; border-left: 3px solid var(--wr-brass);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-dock);
    right: var(--gutter); bottom: var(--gutter);
    /* Rising in: unhurried, with a beat so it does not flicker past a link that
       only just cleared the corner. Clearing out: quick. */
    transition: transform 400ms var(--ease-out) 120ms, opacity 400ms var(--ease-out) 120ms, visibility 0s linear 0s;
  }
  /* visibility takes the tucked ticker out of the tab order too. */
  .ticker.is-tucked {
    transform: translateY(calc(100% + var(--gutter) + 8px));
    opacity: 0;
    visibility: hidden;
    transition: transform 200ms var(--ease-out), opacity 200ms var(--ease-out), visibility 0s linear 200ms;
  }
  :global(html[data-drawer-open]) .ticker {
    transform: translateY(calc(100% + var(--gutter) + 8px));
    visibility: hidden;
  }
  .ticker__body { padding-right: 2.25rem; }
  .ticker__body { padding: 0.75rem 1.25rem; display: flex; flex-direction: column; gap: 3px; min-width: 13rem; }
  .ticker__head {
    display: flex; align-items: center; gap: 0.4375rem;
    font-family: var(--font-label); font-weight: 600; font-size: 0.65625rem;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--wr-mauve-text);
  }
  .ticker__dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--wr-brass);
    animation: wr-pulse 2.4s ease-in-out infinite;
  }
  .ticker__when { font-size: 0.90625rem; font-weight: 600; color: #fff; transition: opacity 120ms var(--ease-out); }
  .ticker__note { font-size: 0.71875rem; color: var(--wr-mauve-text); transition: opacity 120ms var(--ease-out); }
  .ticker__when.is-out, .ticker__note.is-out { opacity: 0; }
  .ticker__note[data-low='true'] { color: var(--wr-gold-tint); }
  .ticker__cta {
    display: flex; align-items: center; padding-inline: 1.375rem;
    background: var(--wr-amber); color: var(--wr-char);
    font-weight: 700; font-size: 0.84375rem;
    transition: background-color var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .ticker__cta:hover { background: var(--wr-amber-hover); color: var(--wr-char); }
  .ticker__cta:active { transform: scale(0.98); }
  .ticker[hidden] { display: none; }

  /* 44px touch target, 10px glyph — the chrome stays quiet. */
  .ticker__x {
    position: absolute; top: 0; right: 0;
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: flex-end;
    padding: 0.625rem 0.625rem 0 0;
    color: var(--wr-mauve-text);
    transition: color var(--duration-base) var(--ease-out);
  }
  .ticker__x:hover { color: #fff; }
  /* On desktop the control sits over the amber Book block, where mauve disappears. */
  @media (min-width: 641px) {
    .ticker__x, .ticker__x:hover { color: var(--wr-char); }
  }

  .is-a, .is-b { animation: wr-rise 260ms var(--ease-out); }
  @keyframes wr-rise { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  @keyframes wr-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  /* Mobile: the pill becomes the docked bar — thumb zone, inside the safe area. */
  @media (max-width: 640px) {
    .ticker {
      right: 0; left: 0; bottom: 0;
      border-radius: 0; border-left: 0; border-top: 2px solid var(--wr-brass);
      padding-bottom: env(safe-area-inset-bottom);
      align-items: center; gap: 0.875rem;
    }
    .ticker__body { flex: 1; min-width: 0; padding: 0.75rem 0 0.75rem 0.875rem; }
    /* On the docked bar the close control gets its own column on the left.
       Overlaying the top-right corner put it on top of the Book button,
       so a thumb aiming to book could dismiss instead. */
    .ticker__x {
      position: static; order: -1;
      width: 44px; height: auto; align-self: stretch;
      justify-content: center; padding: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.12);
    }
    .ticker__when { font-size: 0.9375rem; }
    .ticker__cta { align-self: stretch; margin: 0.5rem var(--gutter) 0.5rem 0; padding-inline: 1.5rem;
      border-radius: var(--radius-sm); min-height: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__dot, .is-a, .is-b { animation: none; }
  }
</style>
